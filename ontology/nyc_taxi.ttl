# =============================================================================
# INFERENCE RULES (Trip Classification)
# =============================================================================

:TripClassificationRule a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Trip Classification Rule" ;
    rdfs:comment "RULE: Classify trips by type using rate_code, distance, time, and location data." ;
    :reasoning """
        1. AirportTrip: rate_code IN (2,3) OR location is airport zone
        2. LongDistanceTrip: trip_distance > 10 miles
        3. CommuteTrip: Rush hour (7-9 AM, 5-8 PM) on weekdays
        4. NightTrip: Between 10 PM and 5 AM
        5. ShortTrip: trip_distance < 2 miles
    """ .

:TipPatternRule a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Tip Pattern Rule" ;
    rdfs:comment "RULE: Tip patterns vary by payment type, zone type, and time of day." ;
    :reasoning """
        1. Cash tips (payment_type=2) are NOT recorded - exclude from tip analysis
        2. Airport trips: Higher tips due to flat rates and tourist travelers
        3. Business districts: Consistent 15-20% tip rates
        4. Tourist zones: Higher tips from visitors
        5. Night trips: Often higher tips due to late-night premium
        6. Commute trips: Lower tips (routine daily trips)
    """ ;
    :sqlExample """
        -- Tip analysis by zone type (credit card only)
        SELECT z.zone_name,
               AVG(t.tip_amount / NULLIF(t.fare_amount, 0)) * 100 as tip_pct
        FROM trips t
        JOIN zones z ON t.pickup_location_id = z.location_id
        WHERE t.payment_type = 1  -- Credit card only
          AND t.fare_amount > 0
        GROUP BY z.zone_name
    """ .

:DemandPredictionRule a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Demand Prediction Rule" ;
    rdfs:comment "RULE: Taxi demand follows predictable patterns based on time and location." ;
    :reasoning """
        1. Manhattan dominates overall demand (~90% of trips)
        2. Rush hours (7-9 AM, 5-8 PM weekdays): Highest demand, concentrated in business districts
        3. Midday (10 AM - 4 PM): Moderate demand, tourist and business mix
        4. Night (10 PM - 5 AM): Entertainment districts peak, residential drops
        5. Weekends: Tourism zones peak, business districts drop
        6. Airport zones: Demand tied to flight schedules
    """ .

:RevenueOptimizationRule a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Revenue Optimization Rule" ;
    rdfs:comment "RULE: Revenue patterns show predictable variations by trip type and location." ;
    :reasoning """
        1. Highest revenue: Airport trips (fixed high fares)
        2. High revenue: Long distance trips (more miles = more fare)
        3. High turnover/volume: Short Manhattan trips (many trips/hour)
        4. Low revenue risk: Cash payments (no tip recorded)
        5. Peak revenue times: Rush hours (surge in volume)
        6. Weekend premium: Entertainment district late nights
    """ ;
    :metrics "total_revenue, avg_fare, trip_count, revenue_per_hour" .

:ZonePerformanceRule a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Zone Performance Rule" ;
    rdfs:comment "RULE: Zone performance metrics vary significantly by zone type." ;
    :reasoning """
        Business Districts: High volume during business hours, short trips, good tips
        Airport Zones: Lower volume, high per-trip revenue, predictable fares
        Tourist Zones: Consistent throughout week, higher tips
        Residential: Lower volume, morning outbound to business, evening inbound
        Transit Hubs: Spiky demand around arrival times
        Entertainment: Night/weekend peaks, longer wait times
    """ ;
    :sqlExample """
        -- Zone performance comparison
        SELECT z.zone_name, z.borough,
               COUNT(*) as trips,
               AVG(t.fare_amount + t.tip_amount) as avg_revenue,
               AVG(t.trip_distance) as avg_distance
        FROM trips t
        JOIN zones z ON t.pickup_location_id = z.location_id
        GROUP BY z.zone_name, z.borough
        ORDER BY trips DESC
    """ .

# =============================================================================
# NEW QUERY PATTERNS (for enriched ontology)
# =============================================================================

:AirportTripAnalysisPattern a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Airport Trip Analysis Pattern" ;
    rdfs:comment "Pattern for analyzing airport trips" ;
    :sqlPattern """
        SELECT
            CASE
                WHEN rate_code_id = 2 THEN 'JFK Flat Rate'
                WHEN rate_code_id = 3 THEN 'Newark'
                WHEN pickup_location_id IN (132, 138) OR dropoff_location_id IN (132, 138) THEN 'LaGuardia'
                ELSE 'Other Airport'
            END as airport_type,
            COUNT(*) as trip_count,
            AVG(fare_amount + tip_amount) as avg_revenue,
            AVG(trip_distance) as avg_distance
        FROM trips
        WHERE rate_code_id IN (2, 3)
           OR pickup_location_id IN (1, 132, 138)
           OR dropoff_location_id IN (1, 132, 138)
        GROUP BY airport_type
    """ .

:TimeContextAnalysisPattern a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Time Context Analysis Pattern" ;
    rdfs:comment "Pattern for analyzing trips by time context" ;
    :sqlPattern """
        SELECT
            CASE
                WHEN (EXTRACT(HOUR FROM pickup_datetime) BETWEEN 7 AND 9
                      OR EXTRACT(HOUR FROM pickup_datetime) BETWEEN 17 AND 20)
                     AND EXTRACT(DOW FROM pickup_datetime) BETWEEN 1 AND 5
                THEN 'Rush Hour'
                WHEN EXTRACT(HOUR FROM pickup_datetime) >= 22
                     OR EXTRACT(HOUR FROM pickup_datetime) < 5
                THEN 'Night Time'
                WHEN EXTRACT(DOW FROM pickup_datetime) IN (0, 6)
                THEN 'Weekend'
                ELSE 'Off-Peak'
            END as time_context,
            COUNT(*) as trip_count,
            AVG(fare_amount + tip_amount) as avg_revenue
        FROM trips
        GROUP BY time_context
    """ .

:TripClassificationPattern a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Trip Classification Pattern" ;
    rdfs:comment "Pattern for classifying trips by type" ;
    :sqlPattern """
        SELECT
            CASE
                WHEN rate_code_id IN (2, 3) THEN 'Airport'
                WHEN trip_distance > 10 THEN 'Long Distance'
                WHEN trip_distance < 2 THEN 'Short'
                WHEN (EXTRACT(HOUR FROM pickup_datetime) BETWEEN 7 AND 9
                      OR EXTRACT(HOUR FROM pickup_datetime) BETWEEN 17 AND 19)
                     AND EXTRACT(DOW FROM pickup_datetime) BETWEEN 1 AND 5
                THEN 'Commute'
                ELSE 'Standard'
            END as trip_type,
            COUNT(*) as trip_count,
            SUM(fare_amount + tip_amount) as total_revenue,
            AVG(tip_amount / NULLIF(fare_amount, 0)) * 100 as avg_tip_pct
        FROM trips
        WHERE payment_type = 1  -- Credit card for tip analysis
        GROUP BY trip_type
    """ .
